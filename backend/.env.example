# Copie este arquivo para ".env" (mesma pasta) e troque os valores.

# Senha do PostgreSQL
DB_PASSWORD=troque_pela_sua_senha

# Texto longo e aleatório para assinar o login (mínimo 32 caracteres). Veja como gerar no README/instruções.
JWT_SECRET=troque_por_um_texto_longo_e_aleatorio_com_mais_de_32_caracteres

# Conta da profissional (criada na primeira vez que o backend liga). A senha precisa ter 10+ caracteres.
ADMIN_NOME=Nome da Profissional
ADMIN_EMAIL=email@exemplo.com
ADMIN_SENHA=troque_por_uma_senha_forte
